// ==========================================
// 🗃️ MYQUEST - SCHÉMA DE BASE DE DONNÉES
// ==========================================
//
// Ce fichier définit la structure de notre base PostgreSQL.
// Prisma utilise ce schéma pour:
// - Créer/modifier les tables (migrations)
// - Générer le client TypeScript typé
//
// COMMANDES UTILES:
// - npx prisma migrate dev    → Crée une migration + applique
// - npx prisma db push        → Applique sans créer de migration (dev)
// - npx prisma studio         → Interface web pour voir les données
// - npx prisma generate       → Régénère le client après modif
//
// RELATIONS:
// User ←──┬──→ Avatar  (1:1 - chaque user a UN avatar)
//         └──→ Stats   (1:1 - chaque user a UNE ligne de stats)

// ============================================
// ⚙️ CONFIGURATION PRISMA
// ============================================

// Generator: crée le client TypeScript
// Après "npx prisma generate", on peut faire:
// import { PrismaClient } from '@prisma/client'
generator client {
  provider = "prisma-client-js"
}

// Datasource: connexion à la base de données
// DATABASE_URL est définie dans .env (ou variable Render)
// Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 👤 MODEL USER - Compte utilisateur
// ============================================
// Stocke les informations de connexion et identité
// C'est la table "maître" - Avatar et Stats y sont liés

model User {
  // ID unique généré automatiquement (format: cuid - compact unique id)
  // Exemple: "clh1234567890abcdef"
  id        String   @id @default(cuid())
  
  // Email de connexion - UNIQUE = pas de doublons possibles
  email     String   @unique
  
  // Mot de passe HASHÉ (jamais en clair!)
  // On utilisera bcrypt pour hasher
  password  String
  
  // Nom d'affichage (optionnel avec ?)
  name      String?
  
  // Dates de création/modification automatiques
  createdAt DateTime @default(now())    // now() = date actuelle à la création
  updatedAt DateTime @updatedAt         // @updatedAt = màj auto à chaque save

  // ── RELATIONS ──
  // Un user a UN avatar (relation 1:1)
  // Le ? signifie que l'avatar peut ne pas encore exister
  avatar Avatar?
  
  // Un user a UNE ligne de stats (relation 1:1)
  stats  Stats?
  
  // Un user a PLUSIEURS quêtes (relation 1:N)
  quests Quest[]
  
  // Un user a PLUSIEURS habitudes (relation 1:N)
  habits Habit[]
  
  // Un user a PLUSIEURS entrées de journal (relation 1:N)
  journalEntries JournalEntry[]
  
  // Un user a PLUSIEURS achievements (relation 1:N)
  achievements UserAchievement[]

  // Un user a UN profil coach (relation 1:1)
  coachProfile CoachProfile?

  // Un user a PLUSIEURS sessions de coaching (relation 1:N)
  coachSessions CoachSession[]

  // Un user a PLUSIEURS propositions de projets du coach (relation 1:N)
  coachProjects CoachProjectProposal[]

  // @@map renomme la table en "users" (convention: pluriel, minuscule)
  @@map("users")
}

// ============================================
// 🦸 MODEL AVATAR - Personnage du joueur
// ============================================
// L'avatar représente le "personnage" de l'utilisateur dans le jeu
// Il gagne de l'XP, monte de niveau, peut être personnalisé

model Avatar {
  id          String   @id @default(cuid())
  
  // Clé étrangère vers User
  // @unique car relation 1:1 (un user = un avatar max)
  userId      String   @unique
  
  // Relation: lie cet avatar à un User
  // onDelete: Cascade = si on supprime le User, l'Avatar est supprimé aussi
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // ── PROGRESSION ──
  // Nom du personnage choisi par l'utilisateur
  name        String   @default("Hero")
  
  // Niveau actuel (commence à 1)
  // Monte quand l'utilisateur atteint des paliers d'XP
  level       Int      @default(1)
  
  // Points d'expérience actuels
  // Ex: 100 XP pour niveau 2, 250 pour niveau 3, etc.
  experience  Int      @default(0)
  
  // Type d'avatar (pour l'apparence/classe)
  // "warrior", "mage", "healer", "rogue", etc.
  avatarType  String   @default("warrior")
  
  // ── PERSONNALISATION ──
  // JSON flexible pour stocker l'apparence
  // Ex: { "hair": "black", "skin": "light", "outfit": "armor1" }
  // On utilise Json car la structure peut évoluer sans migration
  appearance  Json     @default("{}")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("avatars")
}

// ============================================
// 📊 MODEL STATS - Les 7 dimensions de vie
// ============================================
// Chaque dimension va de 0 à 100.
// Anciennes stats (health, energy, wealth) remplacées par
// body, mind, finance + ajout love et career.

model Stats {
  id        String   @id @default(cuid())

  // Lien vers l'utilisateur (1:1)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── LES 7 DIMENSIONS (0-100) ──

  // 💪 Corps — santé physique, sport, sommeil, alimentation
  body      Int      @default(50)

  // 🧠 Esprit — santé mentale, émotions, stress, paix intérieure
  mind      Int      @default(50)

  // 📚 Sagesse — apprentissage, connaissance de soi, introspection
  wisdom    Int      @default(50)

  // 👥 Social — amis, famille, réseau, vie sociale
  social    Int      @default(50)

  // ❤️ Amour — couple, intimité, connexion profonde
  love      Int      @default(50)

  // 🎯 Carrière — travail, projets, ambition, compétences
  career    Int      @default(50)

  // 💰 Finances — argent, patrimoine, sécurité financière
  finance   Int      @default(50)

  // ── STREAKS ──
  currentStreak Int  @default(0)
  longestStreak Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stats")
}

// ============================================
// ⚔️ MODEL QUEST - Quêtes et défis
// ============================================
// Une quête est un objectif que l'utilisateur se fixe.
// Compléter une quête donne de l'XP et peut modifier les stats.

model Quest {
  id          String   @id @default(cuid())
  
  // Lien vers l'utilisateur propriétaire
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // ── INFORMATIONS DE BASE ──
  title       String              // "Faire 30 min de sport"
  description String?             // Description détaillée (optionnel)
  
  // ── CATÉGORIE ──
  // Lié à quelle stat? Permet de savoir quelle stat augmenter
  category    QuestCategory @default(GENERAL)
  
  // ── DIFFICULTÉ & RÉCOMPENSES ──
  // Plus c'est difficile, plus ça rapporte
  difficulty  QuestDifficulty @default(MEDIUM)
  xpReward    Int             @default(25)    // XP gagnés à la complétion
  statBoost   Int             @default(2)     // Points de stat gagnés
  
  // ── ÉTAT ──
  status      QuestStatus @default(ACTIVE)
  
  // ── ÉCHÉANCE (optionnel) ──
  dueDate     DateTime?           // Date limite
  
  // ── TIMESTAMPS ──
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?           // Quand la quête a été complétée

  @@map("quests")
  // Index pour récupérer rapidement les quêtes d'un user
  @@index([userId, status])
}

// ── ENUMS ──

// Catégories de quêtes (liées aux 7 dimensions)
enum QuestCategory {
  BODY      // 💪 Corps
  MIND      // 🧠 Esprit
  WISDOM    // 📚 Sagesse
  SOCIAL    // 👥 Social
  LOVE      // ❤️ Amour
  CAREER    // 🎯 Carrière
  FINANCE   // 💰 Finances
  GENERAL   // ⭐ Général
  // Anciennes valeurs conservées pour compatibilité des données existantes
  HEALTH    // @deprecated → utiliser BODY
  ENERGY    // @deprecated → utiliser MIND
  WEALTH    // @deprecated → utiliser FINANCE
}

// Niveaux de difficulté
enum QuestDifficulty {
  EASY      // Facile: 15 XP, +1 stat
  MEDIUM    // Moyen: 25 XP, +2 stat
  HARD      // Difficile: 50 XP, +5 stat
  EPIC      // Épique: 100 XP, +10 stat
}

// États d'une quête
enum QuestStatus {
  ACTIVE      // En cours
  COMPLETED   // Terminée avec succès
  FAILED      // Échouée (deadline passée)
  ABANDONED   // Abandonnée par l'utilisateur
}

// ============================================
// 🔄 MODEL HABIT - Habitudes récurrentes
// ============================================
// Une habitude est une action répétée régulièrement.
// Contrairement aux quêtes (one-shot), les habitudes se réinitialisent.

model Habit {
  id          String   @id @default(cuid())
  
  // Lien vers l'utilisateur
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // ── INFORMATIONS DE BASE ──
  title       String              // "Méditer 10 minutes"
  description String?             // Description optionnelle
  icon        String   @default("⭐")  // Emoji pour affichage
  
  // ── CATÉGORIE (même que quêtes) ──
  category    QuestCategory @default(GENERAL)
  
  // ── FRÉQUENCE ──
  frequency   HabitFrequency @default(DAILY)
  
  // Pour WEEKLY: quels jours? (stocké en JSON: [1,3,5] = Lun, Mer, Ven)
  // 0=Dim, 1=Lun, 2=Mar, 3=Mer, 4=Jeu, 5=Ven, 6=Sam
  targetDays  Json     @default("[]")
  
  // Combien de fois par période? (ex: 3 fois par semaine)
  targetCount Int      @default(1)
  
  // ── RÉCOMPENSES (plus petites que les quêtes car récurrentes) ──
  xpReward    Int      @default(10)   // XP par complétion
  statBoost   Int      @default(1)    // Stat boost par complétion
  
  // ── ÉTAT ──
  isActive    Boolean  @default(true)  // Habitude activée?

  // ── RAPPEL ──
  reminderTime String?                 // Heure de rappel (format HH:mm)

  // ── PROGRESSION ──
  currentStreak   Int  @default(0)    // Jours consécutifs
  longestStreak   Int  @default(0)    // Record personnel
  totalCompletions Int @default(0)    // Total depuis création
  streakCount     Int  @default(0)    // Streak actuel (Duolingo-style)
  lastCompletedAt DateTime?           // Dernière date de complétion

  // ── TIMESTAMPS ──
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Logs de complétion
  logs        HabitLog[]

  @@map("habits")
  @@index([userId, isActive])
}

// ============================================
// 📋 MODEL HABITLOG - Historique des complétions
// ============================================
// Chaque fois qu'une habitude est complétée, on crée un log.
// Permet de voir l'historique et calculer les streaks.

model HabitLog {
  id          String   @id @default(cuid())
  
  // Lien vers l'habitude
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  
  // Date de complétion (sans l'heure, pour grouper par jour)
  completedDate DateTime @db.Date
  
  // Heure exacte de complétion
  completedAt   DateTime @default(now())
  
  // Note optionnelle
  note        String?

  @@map("habit_logs")
  // Un seul log par habitude par jour
  @@unique([habitId, completedDate])
  @@index([habitId, completedDate])
}

// ── ENUM FRÉQUENCE ──

enum HabitFrequency {
  DAILY       // Tous les jours
  WEEKLY      // Certains jours de la semaine
  WEEKDAYS    // Lun-Ven seulement
  WEEKENDS    // Sam-Dim seulement
}

// ============================================
// 📓 MODEL JOURNALENTRY - Journal personnel
// ============================================
// Entrées de journal pour l'introspection quotidienne.
// Permet de réfléchir sur ses émotions, gratitudes, objectifs.

model JournalEntry {
  id          String   @id @default(cuid())
  
  // Lien vers l'utilisateur
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // ── DATE ──
  // Date de l'entrée (une entrée par jour max)
  entryDate   DateTime @db.Date
  
  // ── CONTENU ──
  // Humeur du jour (1-5)
  mood        Int      @default(3)
  
  // Texte principal du journal
  content     String?  @db.Text
  
  // Gratitudes (stockées en JSON pour flexibilité)
  // Ex: ["Ma famille", "Le beau temps", "Un bon café"]
  gratitudes  Json     @default("[]")
  
  // Objectif du jour
  dailyGoal   String?
  
  // Réflexion/leçon apprise
  reflection  String?  @db.Text
  
  // Tags/thèmes (JSON array)
  tags        Json     @default("[]")
  
  // ── RÉCOMPENSE ──
  // Écrire dans son journal donne un petit bonus XP
  xpAwarded   Boolean  @default(false)
  
  // ── TIMESTAMPS ──
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("journal_entries")
  // Une seule entrée par jour par utilisateur
  @@unique([userId, entryDate])
  @@index([userId, entryDate])
}

// ── ENUM MOOD ──
// Note: On utilise Int (1-5) plutôt qu'un enum pour plus de flexibilité

// ============================================
// 🤖 MODEL COACHPROFILE - Profil Coach V2
// ============================================
// Profil synthétique généré par le LLM après analyse des réponses.
// Stocke valeurs, forces, ombres, rapport chaos/ordre et vision.

model CoachProfile {
  id             String   @id @default(cuid())

  // Lien vers l'utilisateur (1:1)
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── PROFIL SYNTHÉTIQUE (JSON généré par le LLM) ──
  values         Json?    // Valeurs dominantes identifiées
  strengths      Json?    // Forces naturelles
  shadows        Json?    // Zones d'ombre / faiblesses reconnues
  chaosOrder     Json?    // Rapport chaos/ordre (Maps of Meaning)
  vision         Json?    // Vision future
  summary        String?  @db.Text  // Portrait synthétique texte libre

  // ── TRACKING DES ZONES FLOUES ──
  // [{zone: "values", clarity: 0.3, reason: "réponses vagues"}]
  unclearZones   Json?

  // ── PHASE ET ÉTAT ──
  currentPhase   Int      @default(1) // 1=connaissance, 2=vision, 3=habitudes, 4=action
  onboardingDone Boolean  @default(false)

  // ── TIMESTAMPS ──
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("coach_profiles")
}

// ============================================
// 💬 MODEL COACHSESSION - Session de coaching V2
// ============================================
// Session auto-saved avec pause/resume transparente.

model CoachSession {
  id              String   @id @default(cuid())

  // Lien vers l'utilisateur
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── ÉTAT DE LA SESSION ──
  status          String   @default("active") // active, paused, completed
  phase           Int      @default(1)
  topic           String?  // Sujet principal identifié par le LLM

  // Sagesse gagnée dans cette session
  wisdomGained    Int      @default(0)

  // Snapshot du profil au début de session
  profileSnapshot Json?

  // Relation vers les messages individuels
  messages        CoachMessage[]

  // ── TIMESTAMPS ──
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  updatedAt       DateTime @updatedAt

  @@map("coach_sessions")
  @@index([userId, status])
}

// ============================================
// 💬 MODEL COACHMESSAGE - Message de coaching
// ============================================
// Chaque message échangé avec le coach.

model CoachMessage {
  id           String   @id @default(cuid())

  // Lien vers la session
  sessionId    String
  session      CoachSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Contenu du message
  role         String   // "user" | "coach" | "system"
  content      String   @db.Text

  // Metadata scoring (rempli par le LLM pour les messages "user")
  insightScore Int?     // 0-10, profondeur de la réponse
  zone         String?  // Quelle zone du profil cette réponse concerne

  createdAt    DateTime @default(now())

  @@map("coach_messages")
  @@index([sessionId, createdAt])
}

// ============================================
// 📋 MODEL COACHPROJECTPROPOSAL - Proposition de projet
// ============================================
// Projet généré par le coach, en attente de validation utilisateur.

model CoachProjectProposal {
  id          String   @id @default(cuid())

  // Lien vers l'utilisateur
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session ayant généré la proposition (optionnel)
  sessionId   String?

  // ── CONTENU ──
  title       String
  description String   @db.Text
  why         String   @db.Text  // Lien avec le profil
  type        String   // remediation | amplification | alignment | confrontation | vision

  // Stats impactées — ex: {wisdom: 2, social: 3}
  statsImpact Json?

  // ── STATUS ──
  status      String   @default("proposed") // proposed | discussing | validated | rejected

  // Si validé → référence vers le Quest créé
  questId     String?

  // ── TIMESTAMPS ──
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("coach_project_proposals")
  @@index([userId, status])
}

// ============================================
// 🏆 MODEL USERACHIEVEMENT - Achievements débloqués
// ============================================
// Stocke les achievements débloqués par chaque utilisateur

model UserAchievement {
  id            String   @id @default(cuid())
  
  // Lien vers l'utilisateur
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // ID de l'achievement (défini en code, pas en DB)
  achievementId String
  
  // Date de déblocage
  unlockedAt    DateTime @default(now())

  @@map("user_achievements")
  // Un achievement ne peut être débloqué qu'une fois par user
  @@unique([userId, achievementId])
  @@index([userId])
}
